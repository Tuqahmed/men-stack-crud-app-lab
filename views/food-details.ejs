<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Food Details</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('./partials/navbar') %>
    <h1>Food Details</h1>

    <p>Name: <%= food.name %></p>

    <p>Description: <%= food.description %></p>

    <p>Price: <%= food.price %>bd</p>

    <% if(food.isAvailable){ %>
        <p>Available</p>
    <% }else{ %>
        <p>Not Available</p>
    <% } %>

    <form action="/food/<%= food._id %>?_method=DELETE" method="post">
        <button>Delete Food</button>
    </form>
    <br>

    <a href="/food/<%= food._id %>/edit">Edit Food</a>
</body>
</html>